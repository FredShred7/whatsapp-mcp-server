{
  "name": "whatsapp-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for the official Meta WhatsApp Cloud API",
  "type": "module",
  "license": "MIT",
  "author": "FredShred7",
  "homepage": "https://github.com/FredShred7/whatsapp-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FredShred7/whatsapp-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/FredShred7/whatsapp-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "whatsapp",
    "whatsapp-cloud-api",
    "whatsapp-business",
    "meta",
    "claude",
    "ai"
  ],
  "engines": {
